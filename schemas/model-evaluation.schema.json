{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/sbom-workbench/model-evaluation.schema.json",
  "title": "SBOM Workbench Shadow Model Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "classification", "evaluation_id", "pre_registration",
    "card_set_sha256", "cards", "runtime_observations", "arms", "safety_gate",
    "privacy_gate", "benefit_gate", "decision", "authority_boundary",
    "evaluation_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "classification": {"const": "SELF_TEST_NOT_CUSTOMER_EVIDENCE"},
    "evaluation_id": {"type": "string", "pattern": "^m5-[0-9a-f]{64}$"},
    "pre_registration": {"type": "object"},
    "card_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cards": {"type": "array", "minItems": 1, "maxItems": 128},
    "runtime_observations": {"type": "object"},
    "arms": {"type": "array", "minItems": 3, "maxItems": 3},
    "safety_gate": {"enum": ["PASS", "HOLD"]},
    "privacy_gate": {"const": "HOLD_NOT_TECHNICALLY_DEMONSTRATED"},
    "benefit_gate": {"const": "NOT_ASSESSED_NO_INDEPENDENT_HUMAN_TIMING"},
    "decision": {"const": "SHADOW_ONLY_HOLD"},
    "authority_boundary": {"const": "NO_FACT_WRITE_NO_STATE_CHANGE_NO_RELEASE_OR_CONFORMITY_AUTHORITY"},
    "evaluation_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
