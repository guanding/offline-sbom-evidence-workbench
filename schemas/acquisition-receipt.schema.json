{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/sbom-workbench/acquisition-receipt.schema.json",
  "title": "SBOM Workbench Acquisition Receipt 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "acquisition_status", "acquired_at_utc", "dataset_id", "source_url",
    "resolved_source_ips", "registry_sha256", "registry_entry_sha256", "resolved_commit",
    "annotated_tag_object", "git_tree_sha", "git_archive_sha256", "license_expression",
    "license_review_status", "license_evidence", "tool_runtime", "tree_manifest"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "acquisition_status": {"enum": ["SEALED_EXPECTATIONS_MATCHED", "ACQUIRED_UNSEALED"]},
    "acquired_at_utc": {"type": "string", "format": "date-time"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "source_url": {"type": "string", "format": "uri"},
    "resolved_source_ips": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "registry_entry_sha256": {"$ref": "#/$defs/sha256"},
    "resolved_commit": {"$ref": "#/$defs/gitSha"},
    "annotated_tag_object": {"oneOf": [{"$ref": "#/$defs/gitSha"}, {"type": "null"}]},
    "git_tree_sha": {"$ref": "#/$defs/gitSha"},
    "git_archive_sha256": {"$ref": "#/$defs/sha256"},
    "license_expression": {"type": "string", "minLength": 1},
    "license_review_status": {"type": "string", "minLength": 1},
    "license_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "tool_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git", "python"],
      "properties": {
        "git": {"$ref": "#/$defs/runtimeIdentity"},
        "python": {"$ref": "#/$defs/runtimeIdentity"}
      }
    },
    "tree_manifest": {"$ref": "#/$defs/treeManifest"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "treeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "root_id", "file_count", "total_bytes", "exact_set_sha256", "files"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "root_id": {"type": "string", "minLength": 1},
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "exact_set_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative_path", "sha256", "size", "executable"],
            "properties": {
              "relative_path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"},
              "size": {"type": "integer", "minimum": 0},
              "executable": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
