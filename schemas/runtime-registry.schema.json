{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/sbom-workbench/runtime-registry.schema.json",
  "title": "SBOM Workbench Runtime Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_type", "schema_version", "updated_at", "runtimes"],
  "properties": {
    "registry_type": {"const": "runtime-registry"},
    "schema_version": {"const": "1.0"},
    "updated_at": {"type": "string", "format": "date"},
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtime_id", "category", "name", "version", "source_url",
          "resolved_commit", "license_expression", "status", "artifact_sha256",
          "config_sha256", "dependency_manifest_sha256", "notes"
        ],
        "properties": {
          "runtime_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "category": {"enum": ["scanner", "validator", "model_server", "schema"]},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(:443)?/[^?#]+$"},
          "resolved_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license_expression": {"type": "string", "minLength": 1},
          "status": {"enum": ["REGISTERED_NOT_ACQUIRED", "LOCALLY_OBSERVED", "FROZEN"]},
          "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "config_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "dependency_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
