{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/sbom-workbench/synthetic-discovery.schema.json",
  "title": "Orion Synthetic Discovery Lane",
  "x-classification": "SYNTHETIC_NOT_EVIDENCE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "evidence_id",
    "release_id",
    "lane_id",
    "source_kind",
    "authorship",
    "origin",
    "subject",
    "artifact",
    "components",
    "relationships",
    "coverage",
    "blindspots"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "classification": {"const": "SYNTHETIC_NOT_EVIDENCE"},
    "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "lane_id": {"enum": ["build-manifest", "artifact-inventory"]},
    "source_kind": {"enum": ["SYNTHETIC_BUILD_MANIFEST", "SYNTHETIC_ARTIFACT_INVENTORY"]},
    "authorship": {"const": "HUMAN_AUTHORED_PROJECT_SYNTHETIC"},
    "origin": {"$ref": "#/$defs/origin"},
    "subject": {"$ref": "#/$defs/subject"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ROOT_PRODUCT", "TOP_LEVEL", "TRANSITIVE", "BINARY_ONLY_FIRMWARE", "UNKNOWN"]}
    },
    "blindspots": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"lane_id": {"const": "build-manifest"}}},
      "then": {
        "properties": {
          "source_kind": {"const": "SYNTHETIC_BUILD_MANIFEST"},
          "origin": {"properties": {"kind": {"const": "SYNTHETIC_BUILD_DESCRIPTOR"}}}
        }
      }
    },
    {
      "if": {"properties": {"lane_id": {"const": "artifact-inventory"}}},
      "then": {
        "properties": {
          "source_kind": {"const": "SYNTHETIC_ARTIFACT_INVENTORY"},
          "origin": {"properties": {"kind": {"const": "DETERMINISTIC_TAR_ARTIFACT"}}}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "textOrNull": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "hashOrNull": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {"const": "SHA-256"},
            "value": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "supplierHashOrNull": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {"oneOf": [{"const": "SHA-256"}, {"type": "null"}]},
            "value": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_path", "sha256"],
      "properties": {
        "kind": {"enum": ["SYNTHETIC_BUILD_DESCRIPTOR", "DETERMINISTIC_TAR_ARTIFACT"]},
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "name", "version", "identifiers", "role"],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "identifiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "role": {"const": "ROOT_PRODUCT"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"const": "artifacts/orion-bundle.tar"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "source_available"],
      "properties": {
        "kind": {"enum": ["SYNTHETIC_BUILD_RECORD", "SYNTHETIC_BINARY_ARTIFACT", "SYNTHETIC_UNRESOLVED_ARTIFACT"]},
        "locator": {"type": "string", "minLength": 1},
        "source_available": {"type": "boolean"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_role", "producer", "name", "version", "identifiers", "provenance", "observed_hash", "supplier_hash"],
      "properties": {
        "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "component_role": {"enum": ["TOP_LEVEL", "TRANSITIVE", "BINARY_ONLY_FIRMWARE"]},
        "producer": {"$ref": "#/$defs/textOrNull"},
        "name": {"$ref": "#/$defs/textOrNull"},
        "version": {"$ref": "#/$defs/textOrNull"},
        "identifiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "provenance": {"$ref": "#/$defs/provenance"},
        "observed_hash": {"$ref": "#/$defs/hashOrNull"},
        "supplier_hash": {"$ref": "#/$defs/supplierHashOrNull"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "type", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "type": {"enum": ["CONTAINS", "DEPENDS_ON", "GENERATED_FROM"]},
        "to": {"type": "string", "minLength": 1}
      }
    }
  }
}
